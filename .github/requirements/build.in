# build and twine, which Publish and Malware scan use to build the sdist and
# wheel and check their metadata. Compiled to build.txt with exact versions
# and hashes. Dependabot proposes each new release.
#
# Regenerate from .github/requirements/:
#   uv pip compile build.in --universal --generate-hashes --python-version 3.12 -o build.txt
# hatchling is the build backend: builds run with --no-isolation, so it comes
# from this lock rather than a fresh download.
build==1.6.1
twine==7.0.0
hatchling==1.32.4
