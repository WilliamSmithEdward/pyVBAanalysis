# Test tooling for the CI and Publish test gates, pinned with hashes so a run
# installs exactly what was reviewed, including both runtime dependencies.
# The package itself installs afterwards with --no-deps
# --no-build-isolation, so hatchling, its build backend, and editables, which
# hatchling needs for an editable install, come from this lock too. The tool
# versions match the dev extra in pyproject.toml. Compiled for the oldest
# Python the test matrix runs, so one lock serves 3.10 to 3.13:
#   uv pip compile test.in --universal --generate-hashes --python-version 3.10 -o test.txt
# Dependabot proposes each new release.
pytest==9.1.1
ruff==0.16.9
mypy==2.3.1
pyopenvba==6.5.0
defusedxml==0.7.1
hatchling==1.32.4
editables==0.6
# Keep cross-matrix dependencies explicit and unconditional: Dependabot's
# pip-compile resolves on modern Linux and otherwise drops the Python 3.10
# and Windows-only dependencies from this shared hash lock. Installing these
# small compatibility packages on every test runner keeps future updates safe.
colorama==0.4.6
exceptiongroup==1.3.1
tomli==2.4.1
