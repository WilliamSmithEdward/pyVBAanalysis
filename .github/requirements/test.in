# Test tooling for the CI and Publish test gates, pinned with hashes so a run
# installs exactly what was reviewed, with pyOpenVBA, the one runtime
# dependency. The package itself installs afterwards with --no-deps
# --no-build-isolation, so hatchling, its build backend, and editables, which
# hatchling needs for an editable install, come from this lock too. The tool
# versions match the dev extra in pyproject.toml. Compiled for the oldest
# Python the test matrix runs, so one lock serves 3.10 to 3.13:
#   uv pip compile test.in --universal --generate-hashes --python-version 3.10 -o test.txt
# Dependabot proposes each new release.
pytest==9.1.1
ruff==0.16.9
mypy==2.3.1
pyopenvba==6.3.5
hatchling==1.32.4
editables==0.6
